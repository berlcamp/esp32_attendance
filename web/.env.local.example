# Server-only. Never prefix these with NEXT_PUBLIC_.
SUPABASE_URL=https://lvcbmopdstvupjpytjbb.supabase.co
SUPABASE_SERVICE_ROLE_KEY=paste-your-service_role-key-here

# Which reader this board shows. Must match DEVICE_ID in include/config.h AND a
# row in pta.gate_devices — that row is what tells the dashboard which school's
# roster to load. service_role bypasses RLS, so this is the only thing keeping
# another school's students off this screen.
GATE_DEVICE_ID=gate-01

SCHOOL_TZ=Asia/Manila
